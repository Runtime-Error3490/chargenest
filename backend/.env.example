# ===========================================
# EV Charging Marketplace - Backend Environment
# ===========================================

# Database
# Matches docker-compose.yml (docker compose up -d postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ev_charging_marketplace?schema=public"

# Server
NODE_ENV=development
PORT=4000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
JWT_REFRESH_SECRET=your-refresh-token-secret-minimum-32-characters
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# TOTP (MFA) - Key for encrypting TOTP secrets in database
TOTP_ENCRYPTION_KEY=your-32-character-encryption-key!

# PayPal Sandbox
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_MODE=sandbox
PAYPAL_API_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your-webhook-id
# Mock mode: with no real client id/secret above (or PAYPAL_MOCK=true), PayPal is simulated:
# top-ups, holds, invoices and disputes work with dummy PayPal ids. Never active in production.
# PAYPAL_MOCK=true

# AI provider (swap with one line): openrouter | openai | ollama | mock
# "mock" needs no key and gives scripted replies for demos and tests.
# ./run.sh sets mock in a freshly created .env so the app runs without any AI key.
AI_PROVIDER=openrouter
# Optional: overrides the default model of the chosen provider
AI_MODEL=

# OpenRouter
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-3.5-turbo
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI (only if AI_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (only if AI_PROVIDER=ollama; local, no key)
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434/v1

# AI Settings
AI_TEMPERATURE=0
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_DISPUTE_CONFIDENCE_THRESHOLD=0.95

# Platform Settings
PLATFORM_FEE_PERCENT=7
DEFAULT_CURRENCY=INR
DEFAULT_MANDATE_CAP=1000
DEFAULT_MANDATE_DISTANCE_KM=10
DEFAULT_MANDATE_EXPIRY_HOURS=24

# Wallet: balance (INR) a user needs before booking or listing a charger.
WALLET_MIN_BALANCE=500
# Part of it that stays locked as the damage deposit. The rest can be spent on bookings.
WALLET_DEPOSIT=250
# PayPal mock mode only: demo credit for a wallet that has never been used. 0 turns it off.
WALLET_MOCK_CREDIT=1000

# Host payout delay in hours. 0 credits the host at once. A dispute raised before the delay ends freezes the payout.
PAYOUT_DELAY_HOURS=0

# Charger hardware (phase 2). DEVICE_MOCK=true enables POST /api/device/mock/simulate (ignored in production).
DEVICE_MOCK=true
# A device session shorter than this many minutes fails (full refund)
MIN_SESSION_MINUTES=5
# Energy below this over a long enough session counts as a meter fault (full refund)
MIN_ENERGY_KWH=0.05
# Minutes after the booked end before an unfinished or never-unlocked device session is closed automatically
DEVICE_GRACE_MINUTES=10
# Seconds between background runs (auto close and delayed payouts). 0 turns the runner off.
JOB_INTERVAL_SEC=60

# Know Your Agent: secret that encrypts agent signing keys at rest (use a long random value)
KYA_KEY_SECRET=your-kya-key-secret-minimum-32-characters

# Agent defaults
AGENT_DEFAULT_LEVEL=2
AGENT_DEFAULT_SPENDING_LIMIT=5000
AGENT_APPROVAL_EXPIRY_MINUTES=30
